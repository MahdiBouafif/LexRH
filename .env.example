# Copy to .env and fill in the values. NEVER commit .env (only this example file).
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://lexrh:change-me@localhost:5432/lexrh
LOG_LEVEL=INFO

# Mistral key: used for embeddings (and for the answer model below).
MISTRAL_API_KEY=

# Reranker: local cross-encoder (install with `uv sync --extra local-rerank`).
RERANK_BACKEND=local

# Answer model: any OpenAI-compatible API. Mistral shown; use the exact model name
# from your provider's list. Leave GENERATOR_REASONING_EFFORT unset for Mistral models.
GENERATOR_BASE_URL=https://api.mistral.ai/v1
GENERATOR_MODEL=ministral-14b-latest
GENERATOR_API_KEY=
ANSWER_TOP_K=5

# Only needed if you use the optional LLM reranker (RERANK_BACKEND=mistral).
RERANK_MODEL=ministral-8b-latest
CHAT_MIN_INTERVAL=31
